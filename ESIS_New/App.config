<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="ElectronicSystemforIntegratedServices.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
      <section name="ESIS.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="ElectronicSystemforIntegratedServices.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  
  <userSettings>
    <ElectronicSystemforIntegratedServices.My.MySettings>
      <setting name="DefaultPrinterName" serializeAs="String">
        <value />
      </setting>
      <setting name="ARCHIVE_DEFAULT_PATH" serializeAs="String">
        <value>C:\ESIS_Archive\</value>
      </setting>
      <setting name="ServerName" serializeAs="String">
        <value>SERVER-1\SQLEXPRESS</value>
      </setting>
      <setting name="DataBaseName" serializeAs="String">
        <value>ESIS</value>
      </setting>
      <setting name="UserName" serializeAs="String">
        <value />
      </setting>
      <setting name="Password" serializeAs="String">
        <value />
      </setting>
      <setting name="CopyrightText" serializeAs="String">
        <value>© 2026 جميع الحقوق محفوظة</value>
      </setting>
      <setting name="LastLoginUser" serializeAs="String">
        <value />
      </setting>
      <setting name="RememberLastUser" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="WindowState" serializeAs="String">
        <value>Normal</value>
      </setting>
      <setting name="WindowSize" serializeAs="String">
        <value>1024, 768</value>
      </setting>
      <setting name="WindowLocation" serializeAs="String">
        <value>-1, -1</value>
      </setting>
      <setting name="CompressBackup" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="IncludeArchiveFiles" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="AutoDeleteOldBackups" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="KeepBackupsForDays" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="DefaultBackupPath" serializeAs="String">
        <value>Documents\ESIS_Backups</value>
      </setting>
      <setting name="CreateBackupBeforeRestore" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="CloseConnectionsBeforeRestore" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="DefaultPathSearch" serializeAs="String">
        <value>E:\</value>
      </setting>
      <setting name="UseIntegratedSecurity" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="IsConfigured" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="WhatsAppEnabled" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="LoginID" serializeAs="String">
        <value />
      </setting>
      <setting name="LogPassword" serializeAs="String">
        <value />
      </setting>
      <setting name="LoginMothed" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="LoginPort" serializeAs="String">
        <value>1433</value>
      </setting>
      <setting name="ServerIP" serializeAs="String">
        <value />
      </setting>
      <setting name="FrmConStrPASS" serializeAs="String">
        <value>123</value>
      </setting>
      <setting name="WANConString" serializeAs="String">
        <value />
      </setting>
      <setting name="LastSaderNumber" serializeAs="String">
        <value>251230000</value>
      </setting>
      <setting name="daysToKeep" serializeAs="String">
        <value>30</value>
      </setting>
      <setting name="NotificationsFormInterval" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="PDFFolderPath" serializeAs="String">
        <value>C:\ESIS_Archive\PDF</value>
      </setting>
      <setting name="DefaultScaner" serializeAs="String">
        <value />
      </setting>
      <setting name="DefualtImgName" serializeAs="String">
        <value />
      </setting>
      <setting name="ImageFormat" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="ImgFolderPath" serializeAs="String">
        <value />
      </setting>
      <setting name="FilePath" serializeAs="String">
        <value />
      </setting>
      <setting name="FileStoringMethod" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="AttachesStordInternally" serializeAs="String">
        <value>False</value>
      </setting>
    </ElectronicSystemforIntegratedServices.My.MySettings>
    <ESIS.Properties.Settings>
      <!-- إعدادات قاعدة البيانات -->
      <setting name="DatabaseServer" serializeAs="String">
        <value>localhost</value>
      </setting>
      <setting name="DatabaseName" serializeAs="String">
        <value>ESIS</value>
      </setting>
      <setting name="UseIntegratedSecurity" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="DatabaseUser" serializeAs="String">
        <value></value>
      </setting>
      <setting name="DatabasePassword" serializeAs="String">
        <value></value>
      </setting>
      
      <!-- إعدادات المسارات -->
      <setting name="DefaultPathSearch" serializeAs="String">
        <value>C:\ESIS\Archive</value>
      </setting>
      <setting name="ARCHIVE_Default_PATH" serializeAs="String">
        <value>C:\ESIS\Archive</value>
      </setting>
      <setting name="SelectedFolder" serializeAs="String">
        <value>C:\ESIS\Archive</value>
      </setting>
      
      <!-- حالة التهيئة -->
      <setting name="IsConfigured" serializeAs="String">
        <value>False</value>
      </setting>
      
      <!-- إعدادات واجهة المستخدم -->
      <setting name="LastSearchQuery" serializeAs="String">
        <value></value>
      </setting>
      <setting name="LastSearchDateStart" serializeAs="String">
        <value></value>
      </setting>
      <setting name="LastSearchDateEnd" serializeAs="String">
        <value></value>
      </setting>
      <setting name="MainWindowState" serializeAs="String">
        <value>Normal</value>
      </setting>
      <setting name="MainWindowSize" serializeAs="String">
        <value>1200, 800</value>
      </setting>
      <setting name="MainWindowLocation" serializeAs="String">
        <value>100, 100</value>
      </setting>
      
      <!-- إعدادات المستخدم -->
      <setting name="RememberUser" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="LastLoggedInUser" serializeAs="String">
        <value></value>
      </setting>
      <setting name="AutoLogin" serializeAs="String">
        <value>False</value>
      </setting>
      
      <!-- إعدادات الأداء -->
      <setting name="SearchResultsLimit" serializeAs="String">
        <value>500</value>
      </setting>
      <setting name="MaxConcurrentSearches" serializeAs="String">
        <value>3</value>
      </setting>
      <setting name="SearchTimeoutSeconds" serializeAs="String">
        <value>30</value>
      </setting>
      
      <!-- إعدادات الطباعة -->
      <setting name="DefaultPrinter" serializeAs="String">
        <value></value>
      </setting>
      <setting name="PrintPreviewOn" serializeAs="String">
        <value>True</value>
      </setting>
      
      <!-- إعدادات النسخ الاحتياطي -->
      <setting name="BackupPath" serializeAs="String">
        <value>C:\ESIS\Backup</value>
      </setting>
      <setting name="AutoBackupEnabled" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="AutoBackupIntervalDays" serializeAs="String">
        <value>7</value>
      </setting>
      <setting name="LastBackupDate" serializeAs="String">
        <value></value>
      </setting>
      
      <!-- إعدادات التقارير -->
      <setting name="ReportsPath" serializeAs="String">
        <value>C:\ESIS\Reports</value>
      </setting>
      <setting name="DefaultReportFormat" serializeAs="String">
        <value>PDF</value>
      </setting>
      
      <!-- إعدادات المجلدات المحذوفة -->
      <setting name="DeletedFolderPath" serializeAs="String">
        <value>C:\ESIS\Deleted</value>
      </setting>
      <setting name="KeepDeletedFiles" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="DeletedFilesRetentionDays" serializeAs="String">
        <value>30</value>
      </setting>
      
      <!-- إعدادات البحث -->
      <setting name="SearchInSubfolders" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="CaseSensitiveSearch" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="SearchFileContent" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="SearchExtensions" serializeAs="String">
        <value>*.pdf,*.doc,*.docx,*.xls,*.xlsx,*.jpg,*.jpeg,*.png,*.gif,*.bmp</value>
      </setting>
      
      <!-- إعدادات الأرشيف -->
      <setting name="ArchiveDateFormat" serializeAs="String">
        <value>dd/MM/yyyy</value>
      </setting>
      <setting name="AutoGenerateArchiveNumber" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="ArchiveNumberPrefix" serializeAs="String">
        <value>ARC-</value>
      </setting>
      <setting name="ArchiveNumberLength" serializeAs="String">
        <value>6</value>
      </setting>
    </ESIS.Properties.Settings>
  </userSettings>
  
  <connectionStrings>
    <add name="ESIS" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
